module tvPattern(
input [9:0] x,
input [9:0] y,
output reg [3:0] red,
output reg [3:0] green,
output reg [3:0] blue);

always @(x or y) // Corrected from always @(x||y) to always @(x or y)
begin
/*    if(x>= && x<100 && y>=0 && y<100) // Removed the extra closing parenthesis
    begin
        red <= 4'hF;
        green <= 4'hF;
        blue <= 4'hF;
    end else begin 	 
        red <= 4'h0;
        green <= 4'h0;
        blue <= 4'h0;	 
	 end */
	 
    if(x>= 290 && x<390 && y>=190 && y<290) // Removed the extra closing parenthesis
    begin
        red <= 4'hF;
        green <= 4'hF;
        blue <= 4'hF;
    end else begin 	 
        red <= 4'h0;
        green <= 4'h0;
        blue <= 4'h0;	 
	 end 	 
end

endmodul